# =============================================================
# CityParking Backend Environment Variables
# =============================================================

# === Database Configuration ===
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cityparking
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# === JWT Configuration ===
JWT_SECRET=your-secret-key-here-at-least-32-characters
JWT_EXPIRATION=86400000

# === Server Configuration ===
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# === AI Service Configuration ===
# FastAPI service removed — all AI now served by Spring Boot + Gemini + AWS
AI_SERVICE_URL=http://localhost:8080
AI_PROVIDER_FACE=mock
AI_PROVIDER_GEMINI=mock

# === AWS Rekognition Configuration ===
# Set these to enable AWS Rekognition face recognition
# Then change AI_PROVIDER_FACE=aws to activate
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
AWS_COLLECTION_ID=cityparking-faces

# === File Upload Configuration ===
FILE_UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB