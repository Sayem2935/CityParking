# =============================================================
# DIPS Backend Environment Variables
# =============================================================

# === Database Configuration ===
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/dips_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# === JWT Configuration ===
JWT_SECRET=your-secret-key-here-at-least-32-characters
JWT_EXPIRATION=86400000

# === Server Configuration ===
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# === AI Service Configuration ===
# FastAPI InsightFace microservice for face recognition
AI_SERVICE_URL=http://localhost:8080
AI_PROVIDER_FACE=insightface
AI_PROVIDER_GEMINI=mock

# === InsightFace FastAPI Configuration ===
INSIGHTFACE_BASE_URL=http://localhost:8001
INSIGHTFACE_CONNECT_TIMEOUT_MS=5000
INSIGHTFACE_READ_TIMEOUT_MS=30000
INSIGHTFACE_SIMILARITY_THRESHOLD=0.45
INSIGHTFACE_CACHE_REFRESH_MS=300000

# === AWS Rekognition Configuration ===
# Set these to enable AWS Rekognition face recognition
# Then change AI_PROVIDER_FACE=aws to activate
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
AWS_COLLECTION_ID=dips-faces

# === File Upload Configuration ===
FILE_UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10MB