{
  "info": {
    "name": "CityParking API",
    "description": "CityParking University Parking Management System API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "authToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"universityId\": \"UNI123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/profile",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ]
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/users/profile",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"John\",\n  \"lastName\": \"Smith\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Vehicles",
      "item": [
        {
          "name": "Get All Vehicles",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/vehicles",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ]
          }
        },
        {
          "name": "Get Vehicle by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/vehicles/1",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ]
          }
        },
        {
          "name": "Create Vehicle",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/vehicles",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plateNumber\": \"ABC123\",\n  \"vehicleType\": \"CAR\",\n  \"make\": \"Toyota\",\n  \"model\": \"Camry\",\n  \"color\": \"Blue\"\n}"
            }
          }
        },
        {
          "name": "Update Vehicle",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/vehicles/1",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plateNumber\": \"ABC123\",\n  \"vehicleType\": \"CAR\",\n  \"make\": \"Toyota\",\n  \"model\": \"Camry\",\n  \"color\": \"Red\"\n}"
            }
          }
        },
        {
          "name": "Delete Vehicle",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/vehicles/1",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Face Enrollment",
      "item": [
        {
          "name": "Enroll Face",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/face-enrollment",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Upload Face Video",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/face-enrollment/upload",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "video",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Get Enrollment Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/face-enrollment/status",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Face Verification",
      "item": [
        {
          "name": "Verify Face",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/face-verification/verify",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Access Verification",
      "item": [
        {
          "name": "Verify Access",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/access-verification/verify",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "faceImage",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "plateNumber",
                  "value": "ABC123",
                  "type": "text"
                },
                {
                  "key": "zone",
                  "value": "AB4",
                  "type": "text"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Plate Verification",
      "item": [
        {
          "name": "Verify Plate",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/plate-verification/verify",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "plateNumber",
                  "value": "ABC123",
                  "type": "text"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Document Extraction",
      "item": [
        {
          "name": "Extract Document",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/documents/extract",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Parking",
      "item": [
        {
          "name": "Get Availability",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/parking/availability?zone=AB4",
              "host": ["{{baseUrl}}"],
              "path": ["api", "parking", "availability"],
              "query": [
                {
                  "key": "zone",
                  "value": "AB4"
                }
              ]
            }
          }
        },
        {
          "name": "Assign Parking Slot",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/parking/assign",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleId\": 1,\n  \"zone\": \"AB4\"\n}"
            }
          }
        },
        {
          "name": "Release Parking Slot",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/parking/release",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignmentId\": 1\n}"
            }
          }
        },
        {
          "name": "Get Parking Statistics",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/parking/statistics?zone=AB4",
              "host": ["{{baseUrl}}"],
              "path": ["api", "parking", "statistics"],
              "query": [
                {
                  "key": "zone",
                  "value": "AB4"
                }
              ]
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ]
          }
        }
      ]
    }
  ]
}